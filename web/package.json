{
  "name": "roof-quote-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-pricing": "node -e \"try{require('fs').copyFileSync('../pricing.json','src/data/pricing.json')}catch(e){if(e.code!=='ENOENT')throw e;console.log('sync-pricing: ../pricing.json not present (Vercel build), keeping existing src/data/pricing.json')}\"",
    "predev": "npm run sync-pricing",
    "prebuild": "npm run sync-pricing",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "calibrate": "tsx scripts/calibrate.ts",
    "run-tests": "tsx scripts/run-test-properties.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.64.0",
    "@react-pdf/renderer": "^4.5.1",
    "exifr": "^7.1.3",
    "next": "^15.5.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "playwright": "^1.59.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
