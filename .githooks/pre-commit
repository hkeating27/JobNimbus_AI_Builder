#!/usr/bin/env bash
# Pre-commit hook: scan staged changes for known secret patterns and
# abort the commit if any are found.
#
# Tracked patterns:
#   - Google API keys: AIza followed by 35 base64-ish chars
#   - Anthropic API keys: sk-ant-*
#   - OpenAI API keys: sk-proj-* / sk-*
#   - Generic .env-style assignments to suspicious-looking secrets
#
# Activate once after cloning the repo:
#     git config core.hooksPath .githooks
#
# Bypass for one commit only if you ABSOLUTELY know what you're doing:
#     git commit --no-verify

set -euo pipefail

PATTERNS=(
  'AIza[0-9A-Za-z_-]{35}'
  'sk-ant-[A-Za-z0-9_-]{20,}'
  'sk-proj-[A-Za-z0-9_-]{20,}'
)

# Only check staged content (the diff, not working-tree files).
# This way unrelated cached fixtures don't trigger false positives.
STAGED=$(git diff --cached --name-only --diff-filter=AM)
if [[ -z "$STAGED" ]]; then
  exit 0
fi

FOUND=""
for f in $STAGED; do
  # Skip binary files and lockfiles (they don't contain readable secrets
  # and lockfiles can have base64-ish hashes that match the pattern).
  case "$f" in
    *.lock|*.tsbuildinfo|*.png|*.jpg|*.jpeg|*.gif|*.webp|*.pdf|*.woff*|*-lock.json|*-lock.yaml|pnpm-lock.yaml|package-lock.json) continue ;;
  esac
  for p in "${PATTERNS[@]}"; do
    if git diff --cached -- "$f" | grep -E "^\+.*${p}" >/dev/null 2>&1; then
      MATCH=$(git diff --cached -- "$f" | grep -E "^\+.*${p}" | head -1 | sed -E "s/(${p}).*/\1/g; s/^\+/  /; s/(.{8}).*(.{4})$/\1...\2/")
      FOUND="${FOUND}${f}: matched pattern ${p}\n${MATCH}\n"
    fi
  done
done

if [[ -n "$FOUND" ]]; then
  echo ""
  echo "==================================================="
  echo "  pre-commit: SECRET PATTERN DETECTED in staged changes"
  echo "==================================================="
  printf "%b" "$FOUND"
  echo ""
  echo "Fix: remove or redact the secret, then re-stage."
  echo "If this is a false positive, override with: git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
